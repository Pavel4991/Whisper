    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.12",
    "react-router": "^7.18.2",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
