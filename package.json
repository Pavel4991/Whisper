{
  "name": "whisper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @whisper/client",
    "start-server": "npm run start-server -w @whisper/client",
    "develop": "concurrently \"npm:start-server\" \"npm:dev\"",
    "build": "npm run build -w @whisper/client",
    "lint": "npm run lint -w @whisper/client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test -w @whisper/client",
    "test:watch": "npm run test:watch -w @whisper/client",
    "test:coverage": "npm run test:coverage -w @whisper/client",
    "preview": "npm run preview -w @whisper/client"
  },
  "devDependencies": {
    "@hexlet/chat-server": "^2.0.4",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6"
  }
}
